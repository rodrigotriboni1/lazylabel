{
  "root": "page",
  "elements": {
    "page": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg", "align": "stretch" }, "children": ["header", "error", "body", "result", "history"] },
    "header": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "end" }, "children": ["header-text", "refresh"] },
    "header-text": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "children": ["title", "lead"] },
    "title": { "type": "Heading", "props": { "text": "Rotular e aprender", "level": "h1" } },
    "lead": { "type": "Text", "props": { "text": "O modelo sugere rótulos. Regras aplicam os casos válidos, mandam incertezas para a quarentena e só treinam com exemplos confiáveis.", "variant": "muted" } },
    "refresh": { "type": "Button", "props": { "label": "Atualizar", "variant": "secondary" }, "on": { "press": { "action": "refresh" } } },

    "error": { "type": "Alert", "props": { "title": "Não foi possível concluir", "message": { "$state": "/error" }, "type": "error" }, "visible": { "$state": "/error" } },

    "body": { "type": "Grid", "props": { "columns": 2, "gap": "lg" }, "children": ["setup", "policy"] },
    "setup": { "type": "Card", "props": { "title": "Configurar ciclo", "description": "A fonte é só lida; os resultados ficam no workspace." }, "children": ["setup-stack"] },
    "setup-stack": { "type": "Stack", "props": { "direction": "vertical", "gap": "md", "align": "stretch" }, "children": ["source", "task", "task-info", "loading", "empty", "run"] },
    "source": { "type": "Choice", "props": { "label": "Fonte de dados", "placeholder": "Selecione uma fonte", "options": { "$state": "/sourceOptions" }, "value": { "$bindState": "/source" } }, "on": { "change": { "action": "select" } } },
    "task": { "type": "Choice", "props": { "label": "Tarefa de rotulagem", "placeholder": "Selecione uma tarefa", "options": { "$state": "/taskOptions" }, "value": { "$bindState": "/task" } }, "on": { "change": { "action": "select" } } },
    "task-info": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "visible": { "$state": "/hasTask" }, "children": ["inputs", "labels", "model", "no-policy"] },
    "inputs": { "type": "Pills", "props": { "label": "Colunas que o modelo pode usar", "items": { "$state": "/taskInfo/inputs" } } },
    "labels": { "type": "Pills", "props": { "label": "Rótulos permitidos", "items": { "$state": "/taskInfo/labels" } } },
    "model": { "type": "Text", "props": { "text": { "$state": "/taskInfo/model" }, "variant": "caption" } },
    "no-policy": { "type": "Alert", "props": { "title": "Sem política calibrada", "message": "Todos os casos vão para a quarentena e o treino não será promovido.", "type": "warning" }, "visible": { "$state": "/taskInfo/noPolicy" } },
    "loading": { "type": "Spinner", "props": { "label": "Carregando configuração local…" }, "visible": { "$state": "/loading" } },
    "empty": { "type": "Text", "props": { "text": "Configure uma fonte CSV/SQLite e uma tarefa pelo comando lazylabel para começar.", "variant": "muted" }, "visible": { "$state": "/showEmpty" } },
    "run": { "type": "Button", "props": { "label": { "$state": "/runLabel" }, "variant": "primary", "disabled": { "$state": "/runDisabled" } }, "on": { "press": { "action": "run" } } },

    "policy": { "type": "Card", "props": { "title": "Como o ciclo funciona", "description": "Cada etapa fica registrada e pode ser verificada." }, "children": ["policy-stack"] },
    "policy-stack": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "children": ["p1", "p2", "p3", "p4", "to-training"] },
    "p1": { "type": "Text", "props": { "text": "Observar — esquema e qualidade checados por regras fixas." } },
    "p2": { "type": "Text", "props": { "text": "Rotular — só as colunas escolhidas; saída validada." } },
    "p3": { "type": "Text", "props": { "text": "Conter incerteza — conflitos, inválidos e casos sem confiança calibrada vão para a quarentena." } },
    "p4": { "type": "Text", "props": { "text": "Aprender com segurança — treino em lote só com dados confiáveis; promoção depende do holdout e dos gates." } },
    "to-training": { "type": "Link", "props": { "label": "Ver o treinamento", "href": "/training" } },

    "result": { "type": "Card", "props": { "title": "Ciclo concluído", "description": { "$state": "/result/summary" } }, "visible": { "$state": "/showResult" }, "children": ["result-stack"] },
    "result-stack": { "type": "Stack", "props": { "direction": "vertical", "gap": "md" }, "children": ["metrics", "training-row", "reasons"] },
    "metrics": { "type": "Grid", "props": { "columns": 3, "gap": "md" }, "children": ["m-total", "m-applied", "m-quarantined"] },
    "m-total": { "type": "Metric", "props": { "label": "Casos avaliados", "value": { "$state": "/result/total" }, "hint": null } },
    "m-applied": { "type": "Metric", "props": { "label": "Aplicados", "value": { "$state": "/result/applied" }, "hint": null } },
    "m-quarantined": { "type": "Metric", "props": { "label": "Em quarentena", "value": { "$state": "/result/quarantined" }, "hint": null } },
    "training-row": { "type": "Stack", "props": { "direction": "horizontal", "gap": "sm", "align": "center" }, "children": ["training-label", "training-state"] },
    "training-label": { "type": "Text", "props": { "text": "Treinamento:" } },
    "training-state": { "type": "Badge", "props": { "text": { "$state": "/result/trainingState" }, "variant": "outline" } },
    "reasons": { "type": "Text", "props": { "text": { "$state": "/result/reasons" }, "variant": "caption" } },

    "history": { "type": "Card", "props": { "title": "Histórico", "description": "Execuções anteriores neste projeto." }, "children": ["no-runs", "run-list"] },
    "no-runs": { "type": "Text", "props": { "text": "Nenhum ciclo executado neste projeto.", "variant": "muted" }, "visible": { "$state": "/noRuns" } },
    "run-list": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "repeat": { "statePath": "/runs", "key": "id" }, "children": ["run-row"] },
    "run-row": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "center" }, "children": ["run-text", "run-badge"] },
    "run-text": { "type": "Text", "props": { "text": { "$item": "text" } } },
    "run-badge": { "type": "Badge", "props": { "text": { "$item": "training" }, "variant": "outline" } }
  }
}
