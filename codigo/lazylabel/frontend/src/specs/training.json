{
  "root": "page",
  "elements": {
    "page": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg", "align": "stretch" }, "children": ["header", "error", "workflow", "evaluation", "body", "history"] },
    "header": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "end" }, "children": ["header-text", "refresh"] },
    "header-text": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "children": ["title", "lead"] },
    "title": { "type": "Heading", "props": { "text": "Treino com promoção segura", "level": "h1" } },
    "lead": { "type": "Text", "props": { "text": "Rótulos confiáveis alimentam ciclos em lote. A avaliação no holdout decide a promoção; faltando dados, política ou evidência, o modelo atual continua.", "variant": "muted" } },
    "refresh": { "type": "Button", "props": { "label": "Atualizar", "variant": "secondary" }, "on": { "press": { "action": "refresh" } } },

    "error": { "type": "Alert", "props": { "title": "Não foi possível carregar", "message": { "$state": "/error" }, "type": "error" }, "visible": { "$state": "/error" } },

    "workflow": { "type": "Card", "props": { "title": "Ciclo autônomo de treinamento", "description": "Treino em lote; só há promoção quando o holdout congelado e todos os gates passam." }, "children": ["steps"] },
    "steps": { "type": "Steps", "props": { "label": "Workflow de treinamento autônomo", "current": { "$state": "/step" }, "steps": [
      { "title": "Verificar dados", "detail": "Integridade, qualidade e proveniência" },
      { "title": "Dividir", "detail": "Treino · calibração · holdout congelado" },
      { "title": "Treinar", "detail": "Lote local com exemplos confiáveis" },
      { "title": "Avaliar", "detail": "Métricas recalculadas no holdout" },
      { "title": "Decidir", "detail": "Gates definidos para a tarefa" },
      { "title": "Promover / rejeitar", "detail": "Decisão automática registrada" },
      { "title": "Monitorar / reverter", "detail": "Rollback automático com evidência" }
    ] } },

    "evaluation": { "type": "Card", "props": { "title": "Avaliação mais recente", "description": { "$state": "/evaluation/summary" } }, "visible": { "$state": "/hasEvaluation" }, "children": ["eval-grid"] },
    "eval-grid": { "type": "Grid", "props": { "columns": 4, "gap": "md" }, "repeat": { "statePath": "/evaluation/metrics", "key": "label" }, "children": ["eval-metric"] },
    "eval-metric": { "type": "Metric", "props": { "label": { "$item": "label" }, "value": { "$item": "value" }, "hint": { "$item": "hint" } } },

    "body": { "type": "Grid", "props": { "columns": 2, "gap": "lg" }, "children": ["active", "gates"] },
    "active": { "type": "Card", "props": { "title": "Modelo ativo", "description": "O modelo usado hoje na rotulagem." }, "children": ["active-loading", "no-active", "active-list"] },
    "active-loading": { "type": "Spinner", "props": { "label": "Carregando estado…" }, "visible": { "$state": "/loading" } },
    "no-active": { "type": "Text", "props": { "text": "Nenhum adapter promovido. O modelo base continua em uso quando a política permite.", "variant": "muted" }, "visible": { "$state": "/noActive" } },
    "active-list": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "repeat": { "statePath": "/activeModels", "key": "task" }, "children": ["active-row"] },
    "active-row": { "type": "Stack", "props": { "direction": "vertical", "gap": "none" }, "children": ["active-task", "active-ref"] },
    "active-task": { "type": "Heading", "props": { "text": { "$item": "task" }, "level": "h4" } },
    "active-ref": { "type": "Text", "props": { "text": { "$item": "ref" }, "variant": "caption" } },

    "gates": { "type": "Card", "props": { "title": "Estado dos gates", "description": "Sem evidência, nada é treinado nem promovido." }, "children": ["no-cycle", "cycle"] },
    "no-cycle": { "type": "Text", "props": { "text": "Aguardando a primeira execução do ciclo autônomo.", "variant": "muted" }, "visible": { "$state": "/noCycle" } },
    "cycle": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "visible": { "$state": "/hasCycle" }, "children": ["cycle-head", "cycle-reasons", "cycle-promotion"] },
    "cycle-head": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "center" }, "children": ["cycle-task", "cycle-state"] },
    "cycle-task": { "type": "Text", "props": { "text": { "$state": "/cycle/task" } } },
    "cycle-state": { "type": "Badge", "props": { "text": { "$state": "/cycle/state" }, "variant": "outline" } },
    "cycle-reasons": { "type": "Pills", "props": { "label": "Motivos", "items": { "$state": "/cycle/reasons" } }, "visible": { "$state": "/cycle/hasReasons" } },
    "cycle-promotion": { "type": "Text", "props": { "text": { "$state": "/cycle/promotion" }, "variant": "caption" } },

    "history": { "type": "Card", "props": { "title": "Histórico de ciclos e decisões" }, "children": ["no-history", "history-list"] },
    "no-history": { "type": "Text", "props": { "text": "Ainda não há ciclos ou decisões registrados.", "variant": "muted" }, "visible": { "$state": "/noHistory" } },
    "history-list": { "type": "Stack", "props": { "direction": "vertical", "gap": "md" }, "repeat": { "statePath": "/history", "key": "id" }, "children": ["history-row"] },
    "history-row": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "children": ["history-head", "history-detail", "history-reasons"] },
    "history-head": { "type": "Stack", "props": { "direction": "horizontal", "justify": "between", "align": "center" }, "children": ["history-title", "history-badge"] },
    "history-title": { "type": "Heading", "props": { "text": { "$item": "title" }, "level": "h4" } },
    "history-badge": { "type": "Badge", "props": { "text": { "$item": "badge" }, "variant": "outline" } },
    "history-detail": { "type": "Text", "props": { "text": { "$item": "detail" }, "variant": "caption" } },
    "history-reasons": { "type": "Pills", "props": { "label": "Motivos", "items": { "$item": "reasons" } } }
  }
}
