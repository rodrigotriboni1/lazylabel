{
  "root": "page",
  "elements": {
    "page": { "type": "Stack", "props": { "direction": "vertical", "gap": "lg", "align": "stretch" }, "children": ["header", "form"] },
    "header": { "type": "Stack", "props": { "direction": "vertical", "gap": "sm" }, "children": ["title", "lead"] },
    "title": { "type": "Heading", "props": { "text": "Perguntar", "level": "h1" } },
    "lead": { "type": "Text", "props": { "text": "Faça uma pergunta sobre uma fonte. O LazyLabel calcula os números de forma exata e a IA monta a tela com eles.", "variant": "muted" } },
    "form": { "type": "Card", "props": { "title": "Sua pergunta" }, "children": ["no-sources", "fields", "progress", "error"] },
    "no-sources": { "type": "Text", "props": { "text": "Nenhuma fonte configurada. Adicione uma pelo comando lazylabel source para começar.", "variant": "muted" }, "visible": { "$state": "/noSources" } },
    "fields": { "type": "Stack", "props": { "direction": "vertical", "gap": "md", "align": "stretch" }, "visible": { "$state": "/hasSources" }, "children": ["source", "question", "ask"] },
    "source": { "type": "Choice", "props": { "label": "Fonte", "placeholder": null, "options": { "$state": "/sourceOptions" }, "value": { "$bindState": "/source" } } },
    "question": { "type": "Textarea", "props": { "label": "Pergunta", "name": "ask-question", "rows": 3, "placeholder": "Ex.: Como o saldo se divide por categoria ao longo dos meses?", "value": { "$bindState": "/question" } } },
    "ask": { "type": "Button", "props": { "label": "Gerar tela",  "variant": "primary",
      "disabled": { "$cond": { "$state": "/busy" }, "$then": true, "$else": { "$cond": { "$state": "/question", "eq": "" }, "$then": true, "$else": false } } },
      "on": { "press": { "action": "ask" } } },
    "progress": { "type": "Status", "props": { "text": { "$state": "/progress" } }, "visible": { "$state": "/progress" } },
    "error": { "type": "Alert", "props": { "title": "Não foi possível gerar a tela", "message": { "$state": "/error" }, "type": "error" }, "visible": { "$state": "/error" } }
  }
}
